@model IEnumerable<Asistente>
@{
    ViewData["Title"] = "Asistentes";
    var lista = Model.ToList();
}

<div class="page-header">
    <div>
        <h1>Asistentes</h1>
        <p>@lista.Count asistentes activos registrados.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="user-plus"></i> Nuevo asistente</a>
</div>

<div class="card-soft flush">
    @if (lista.Count == 0)
    {
        <div class="empty-state">
            <i data-lucide="users"></i>
            <p class="mb-0">Aún no hay asistentes registrados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr><th>Asistente</th><th>DNI</th><th>Correo</th><th>Teléfono</th></tr>
                </thead>
                <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar">@item.Nombres.Substring(0, 1).ToUpper()</div>
                                <span class="cell-title">@item.Nombres</span>
                            </div>
                        </td>
                        <td>@item.Dni</td>
                        <td>@item.Correo</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>