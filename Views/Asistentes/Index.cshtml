@model IEnumerable<Asistente>
@{ ViewData["Title"] = "Asistentes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asistentes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo asistente</a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr><th>Nombres</th><th>DNI</th><th>Correo</th><th>Teléfono</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombres</td>
            <td>@item.Dni</td>
            <td>@item.Correo</td>
            <td>@item.Telefono</td>
        </tr>
    }
    </tbody>
</table>