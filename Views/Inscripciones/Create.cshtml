@model Inscripcion
@{ ViewData["Title"] = "Nueva inscripción"; }

<h1 class="h3 mb-3">Nueva inscripción</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="EventoId" class="form-label"></label>
            <select asp-for="EventoId" class="form-select" asp-items="(SelectList)ViewBag.Eventos"></select>
            <span asp-validation-for="EventoId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AsistenteId" class="form-label"></label>
            <select asp-for="AsistenteId" class="form-select" asp-items="(SelectList)ViewBag.Asistentes"></select>
            <span asp-validation-for="AsistenteId" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Inscribir</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }