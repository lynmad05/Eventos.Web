@model Evento
@{ ViewData["Title"] = "Nuevo evento"; }

<div class="page-header">
    <div>
        <h1>Nuevo evento</h1>
        <p>Completa los datos para registrar un evento.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i data-lucide="arrow-left"></i> Volver</a>
</div>

<div class="card-soft form-card">
    <form asp-action="Create" method="post">
        <partial name="_Campos" />
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar evento</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }