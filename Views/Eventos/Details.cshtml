@model Evento
@{ ViewData["Title"] = "Detalle del evento"; }

<h1 class="h3 mb-3">@Model.Titulo</h1>

<dl class="row">
    <dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria?.Nombre</dd>
    <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Lugar</dt><dd class="col-sm-9">@Model.Lugar</dd>
    <dt class="col-sm-3">Precio</dt><dd class="col-sm-9">S/ @Model.Precio.ToString("N2")</dd>
    <dt class="col-sm-3">Aforo</dt><dd class="col-sm-9">@Model.Aforo</dd>
    <dt class="col-sm-3">Inscritos</dt><dd class="col-sm-9">@Model.Inscripciones.Count</dd>
    <dt class="col-sm-3">Cupos disponibles</dt><dd class="col-sm-9">@(Model.Aforo - Model.Inscripciones.Count)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>