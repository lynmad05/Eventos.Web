@model IEnumerable<Evento>
@{ ViewData["Title"] = "Eventos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="categoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias" onchange="this.form.submit()">
            <option value="">Todas las categorías</option>
        </select>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Fecha</th>
            <th>Lugar</th>
            <th class="text-end">Precio</th>
            <th class="text-center">Aforo</th>
            <th class="text-center">Inscritos</th>
            <th class="text-center">Cupos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var inscritos = item.Inscripciones.Count;
        <tr>
            <td>@item.Titulo</td>
            <td>@item.Categoria?.Nombre</td>
            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Lugar</td>
            <td class="text-end">S/ @item.Precio.ToString("N2")</td>
            <td class="text-center">@item.Aforo</td>
            <td class="text-center">@inscritos</td>
            <td class="text-center">
                <span class="badge @(item.Aforo - inscritos > 0 ? "bg-success" : "bg-danger")">@(item.Aforo - inscritos)</span>
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>