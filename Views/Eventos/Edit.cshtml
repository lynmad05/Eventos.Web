@model Evento
@{ ViewData["Title"] = "Editar evento"; }

<div class="page-header">
    <div>
        <h1>Editar evento</h1>
        <p>Actualiza la información de <strong>@Model.Titulo</strong>.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i data-lucide="arrow-left"></i> Volver</a>
</div>

<div class="card-soft form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />
        <partial name="_Campos" />
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar cambios</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }