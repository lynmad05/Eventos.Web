@model Evento
@{ ViewData["Title"] = "Eliminar evento"; }

<div class="card-soft form-card">
    <div class="confirm-icon"><i data-lucide="trash-2"></i></div>
    <h1 class="h4 fw-bold">Eliminar evento</h1>
    <p class="text-muted">El evento dejará de mostrarse en el listado. Esta acción no borra los datos de la base de datos.</p>

    <div class="detail-grid my-4">
        <div class="detail-item">
            <div class="label"><i data-lucide="ticket"></i> Evento</div>
            <div class="value">@Model.Titulo</div>
        </div>
        <div class="detail-item">
            <div class="label"><i data-lucide="calendar"></i> Fecha</div>
            <div class="value">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="detail-item">
            <div class="label"><i data-lucide="map-pin"></i> Lugar</div>
            <div class="value">@Model.Lugar</div>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger"><i data-lucide="trash-2"></i> Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-light">Cancelar</a>
    </form>
</div>